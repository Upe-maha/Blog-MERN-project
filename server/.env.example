# Copy to .env and fill in. Every var without a default is required — the server refuses to start
# with an invalid environment rather than failing later at an unrelated call site.

# --- Core ---------------------------------------------------------------------
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/blog-mern

# --- Auth ---------------------------------------------------------------------
# Minimum 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# --- CORS ---------------------------------------------------------------------
# The browser origin of the Next.js client. Must be a full URL.
CLIENT_URL=http://localhost:3000
# Optional extra origins, comma-separated (e.g. a custom domain in production).
CORS_ORIGINS=
# Allow any https://<something>.vercel.app origin. Only enable for preview deployments.
ALLOW_VERCEL_PREVIEWS=false

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=debug

# --- Rate limiting ------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# --- Data integrity -----------------------------------------------------------
# Multi-document transactions require a replica set. MongoDB Atlas is one; a standalone local
# `mongod` is not, and enabling this against one makes account deletion fail. Turn it on in
# production so the delete-account cascade is atomic.
ENABLE_TRANSACTIONS=false

# --- Admin bootstrap ----------------------------------------------------------
# Read only by `npm run seed:admin`, which creates (or promotes) the admin account. There is no
# self-service admin signup. Re-running is safe: an existing account keeps its password.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional; defaults to the part of ADMIN_EMAIL before the @.
ADMIN_USERNAME=

# Uploads. Required — there is no local-disk fallback, because Render and Railway wipe the
# filesystem on every redeploy. Free tier at https://cloudinary.com.
#
# ⚠️ The key must have BOTH read and write permissions on the product environment. Cloudinary's
# newer console can issue scoped, read-only keys, and one of those authenticates perfectly — the
# SDK's api.ping() returns {"status":"ok"} — while every upload fails with
#     403 "Request forbidden due to missing permissions (actions=[\"create\"])"
# Use the default/master key under Settings -> API Keys, or grant the key `create`.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional. The parent folder every upload is nested under.
CLOUDINARY_FOLDER=blog-mern
