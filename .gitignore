# Impeccable — machine-local artifacts. The design tokens (.impeccable/design.json,
# .impeccable/config.json) are committed; per-developer state is not.
.impeccable/config.local.json
.impeccable/live/
.impeccable/cache/

# Claude Code per-machine settings (the design hook lives here)
.claude/settings.local.json

# mongod binary cached by CI (MONGOMS_DOWNLOAD_DIR in .github/workflows/ci.yml)
.mongodb-binaries/

# Root-level catch-alls. The leading slash anchors each to the repo root on purpose: an unanchored
# `.env*` would also match server/.env.example, which must stay committed.
/.env
/.env.*
/node_modules/

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
*~

# Internal working documents. The architecture guide, the design system, the product notes and the
# phase-by-phase plan are kept local rather than published with the repository — they are how the
# work is done, not part of what ships.
CLAUDE.md
DESIGN.md
PRODUCT.md
SECURITY.md
/docs/

# Markdown is ignored by default so scratch notes and generated reports stay out. README files are
# the exception, because they are what a visitor to the repository reads first.
#
# ⚠️ Negation cannot rescue a file whose parent directory is excluded, which is why `/docs/` above
# is absolute and nothing inside it can be negated back in.
*.md
!README.md
!*/README.md
